# Copy this file to .env for local use. On Vercel, add the same names in
# Project Settings -> Environment Variables. Never commit your real key.

# Required for the Ask page. Free key: https://console.groq.com/keys
LLM_API_KEY=

# Optional (defaults shown). Any OpenAI-compatible provider works.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
MAX_TOKENS=800
TEMPERATURE=0.2
LOW_SCORE_THRESHOLD=0.4
